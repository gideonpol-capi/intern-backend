# Copy this file to .env:  cp .env.example .env
DEBUG=True
SECRET_KEY=change-me-local-only
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://app:app@db:5432/app
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Path *inside the container* to your Firebase service-account JSON (used from Task 3).
# You create the key in Task 3. Save it in the project root as firebase-service-account.json; it is git-ignored.
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json

# Linux only: set these to the output of `id -u` and `id -g` if they are not 1000.
UID=1000
GID=1000

# Host ports. Change them if something else on your machine already uses them.
WEB_HOST_PORT=8000
DB_HOST_PORT=5433
