{
  "info": {
    "name": "Todo API",
    "description": "Requests for the intern backend. Select the environment \"Todo API (local)\" and fill in your Firebase Web API key, email and password: the collection's pre-request script logs in to Firebase and sends the ID token with every request. To act as another user, duplicate the environment and change email and password.\n\nEach folder names the task that adds its endpoints; before that task, those requests fail.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{idToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Logs in to Firebase with the email and password from the environment and stores the ID token.",
          "// Every request in this collection sends it as \"Authorization: Bearer <token>\" (see the Authorization tab).",
          "// The token is reused until five minutes before it expires, or until you switch to another user.",
          "const apiKey = pm.variables.get(\"firebaseApiKey\");",
          "const email = pm.variables.get(\"email\");",
          "const password = pm.variables.get(\"password\");",
          "const skip = pm.request.auth && pm.request.auth.type === \"noauth\";",
          "",
          "if (!skip) {",
          "    if (!apiKey || !email || !password) {",
          "        console.warn(\"Fill in firebaseApiKey, email and password in your Postman environment.\");",
          "    } else {",
          "        const cachedEmail = pm.collectionVariables.get(\"idTokenEmail\");",
          "        const expiresAt = Number(pm.collectionVariables.get(\"idTokenExpiresAt\") || 0);",
          "        if (cachedEmail !== email || Date.now() > expiresAt - 5 * 60 * 1000) {",
          "            pm.sendRequest({",
          "                url: pm.variables.get(\"firebaseAuthUrl\") + \"?key=\" + apiKey,",
          "                method: \"POST\",",
          "                header: { \"Content-Type\": \"application/json\" },",
          "                body: { mode: \"raw\", raw: JSON.stringify({ email: email, password: password, returnSecureToken: true }) }",
          "            }, function (err, res) {",
          "                if (err) {",
          "                    console.error(\"Could not reach Firebase:\", err);",
          "                    return;",
          "                }",
          "                const body = res.json();",
          "                if (res.code !== 200) {",
          "                    console.error(\"Firebase login failed:\", body.error ? body.error.message : res.status);",
          "                    pm.collectionVariables.unset(\"idToken\");",
          "                    return;",
          "                }",
          "                pm.collectionVariables.set(\"idToken\", body.idToken);",
          "                pm.collectionVariables.set(\"idTokenEmail\", email);",
          "                pm.collectionVariables.set(\"idTokenExpiresAt\", String(Date.now() + Number(body.expiresIn) * 1000));",
          "            });",
          "        }",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "firebaseAuthUrl",
      "value": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword"
    },
    {
      "key": "idToken",
      "value": ""
    },
    {
      "key": "idTokenEmail",
      "value": ""
    },
    {
      "key": "idTokenExpiresAt",
      "value": "0"
    },
    {
      "key": "listId",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
